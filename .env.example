# ── Dex Trove local environment template ─────────────────────────────────────
# Copy to .env and fill in only what you need. Never commit .env (it is gitignored).

# ── Publishing via uv ─────────────────────────────────────────────────────────
# Used by: make publish-testpypi / make publish-pypi
# In CI, OIDC Trusted Publishing is used instead — no token needed.
UV_PUBLISH_TOKEN=pypi-xxxx_replace_me
UV_PUBLISH_TOKEN_TESTPYPI=pypi-xxxx_replace_me

# ── Learning ─────────────────────────────────────────────────────────────────
# Where upstream sources are cloned (default ~/.cache/dex-trove)
# DEX_TROVE_CACHE=
# Point the CLI at a different trove directory (default: installed wheel, or ./trove in a checkout)
# DEX_TROVE_ROOT=

# ── Security scanning ─────────────────────────────────────────────────────────
# Gitleaks licence key (optional — community edition works without it)
# GITLEAKS_LICENSE=
